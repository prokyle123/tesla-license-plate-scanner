[Unit]
Description=TeslaCam Plate Dashboard (web)
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/teslacam-plate-dashboard
ExecStart=/opt/teslacam-plate-dashboard/venv/bin/python -m app.webapp --config /opt/teslacam-plate-dashboard/config.json --host 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=teslacam-plate.target
